# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# ===== REQUIRED =====

# Directus CMS API URL
# Example: https://api.alphawaves.com or http://localhost:8055
VITE_DIRECTUS_URL=https://your-directus-instance.com

# Your website URL
# Example: https://alphawaves.com or http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# ===== OPTIONAL =====

# Google Maps API Key (for map integration)
VITE_GOOGLE_MAPS_API=your_api_key_here

# reCAPTCHA Site Key (for form spam protection)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google Analytics ID (for tracking)
VITE_ANALYTICS_ID=G-your_analytics_id

# ===== NOTES =====
# - All VITE_ prefixed variables are available in browser code
# - Never use this file for sensitive data (passwords, tokens)
# - Add .env.local to .gitignore (never commit it)
# - Use HTTPS URLs in production
